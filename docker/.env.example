# Copy to docker/.env and adjust. Unset values fall back to the service
# defaults; the full catalog is documented in docs/operations.md.

# Embeddings endpoint (required). The model is per job in jobs.yaml, not here.
QI_EMBEDDING_API_URL=CHANGE_ME
QI_EMBEDDING_API_KEY=CHANGE_ME

# Encrypts the connection api-keys stored in connections.yaml (required to
# store a key; connections without one work without it). Any sufficiently
# random string; rotating it invalidates every stored key.
QI_CONNECTIONS_SECRET=CHANGE_ME

# REST control plane bearer token (required for every /v1 call)
QI_API_TOKEN=CHANGE_ME

# Web interface (optional)
#
# All four values must be present or the interface is not mounted at all.
# OIDC_ISSUER is shared with the MCP endpoint. See docs/ui.md.
# OIDC_ISSUER=https://auth.example.com/realms/papaia
# QI_UI_PUBLIC_URL=https://ingest.example.com
# QI_UI_CLIENT_SECRET=CHANGE_ME
# QI_UI_SESSION_SECRET=CHANGE_ME
# QI_UI_CLIENT_ID=qdrant-ingest-ui
# QI_UI_PATH=/ui
# QI_UI_SESSION_TTL=28800
# QI_UI_ENABLED=true

# Optional overrides
# QI_HTTP_PORT=8300
# QI_TIKA_HEAP=2g
# QI_CONFIG_DIR=./config
# QI_TIMEZONE=UTC
# QI_LOG_LEVEL=INFO
